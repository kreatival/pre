generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  WORKSHOP_ADMIN
  OPERATOR
  USER
  ADMIN
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum MeasurementStatus {
  DRAFT
  COMPLETED
}

enum OpeningSide {
  NONE
  LEFT
  RIGHT
  BOTH
}

enum ItemType {
  FIXED
  TILT_TURN
  SLIDING
  DOOR
  PANEL_DOOR
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(USER)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clients      Client[]
  quotations   Quotation[]
  measurements Measurement[]
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  notes        String?
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quotations   Quotation[]
  measurements Measurement[]

  @@index([name])
}

model Quotation {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  date        DateTime        @default(now())
  validUntil  DateTime?
  status      QuotationStatus @default(DRAFT)
  currency    String          @default("EUR")
  discountPct Decimal         @default(0) @db.Decimal(5, 2)
  vatPct      Decimal         @default(0) @db.Decimal(5, 2)
  notes       String?
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       QuotationItem[]
  measurement Measurement?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([date])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  type        ItemType  @default(TILT_TURN)
  series      String?
  widthMm     Int
  heightMm    Int
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  leaves      Int       @default(1)
  color       String?
  glass       String?
  mechanism   String?
  shutter     Boolean   @default(false)
  motor       Boolean   @default(false)
  mosquitoNet Boolean   @default(false)
  notes       String?

  @@index([quotationId])
}

model Measurement {
  id          String            @id @default(cuid())
  number      Int               @unique @default(autoincrement())
  date        DateTime          @default(now())
  status      MeasurementStatus @default(DRAFT)
  siteAddress String?
  /// Millimetres deducted from the smallest measured width and height to get the order size.
  clearanceMm Int               @default(0)
  notes       String?
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quotationId String?           @unique
  quotation   Quotation?        @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       MeasurementLine[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([date])
}

model MeasurementLine {
  id            String      @id @default(cuid())
  measurementId String
  measurement   Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  position      Int
  location      String?
  label         String?
  type          ItemType    @default(TILT_TURN)
  quantity      Int         @default(1)
  widthTopMm    Int?
  widthMidMm    Int?
  widthBottomMm Int?
  heightLeftMm  Int?
  heightMidMm   Int?
  heightRightMm Int?
  diagonal1Mm   Int?
  diagonal2Mm   Int?
  wallDepthMm   Int?
  opening       OpeningSide @default(NONE)
  series        String?
  color         String?
  shutter       Boolean     @default(false)
  motor         Boolean     @default(false)
  mosquitoNet   Boolean     @default(false)
  notes         String?

  @@index([measurementId])
}
